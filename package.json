{
  "name": "kotonoha",
  "displayName": "Kotonoha",
  "description": "Semantic lineage (MeaningDelta, RDE, Review) in VS Code — M3 Minimal UI",
  "version": "0.1.0",
  "publisher": "zyx-corporation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyx-corporation/kotonoha-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Kotonoha",
      "properties": {
        "kotonoha.cliPath": {
          "type": "string",
          "default": "kotonoha",
          "description": "Path to the kotonoha CLI binary."
        },
        "kotonoha.projectPath": {
          "type": "string",
          "default": "",
          "description": "Repository root (empty = workspace folder)."
        },
        "kotonoha.databaseUrl": {
          "type": "string",
          "default": "",
          "description": "PostgreSQL URL (prefer SecretStorage in future; do not commit)."
        },
        "kotonoha.decidedBy": {
          "type": "string",
          "default": "",
          "description": "Default identity for review decisions."
        },
        "kotonoha.principalId": {
          "type": "string",
          "default": "",
          "description": "M6/M7 principal UUID (KOTONOHA_PRINCIPAL_ID for CLI child processes)."
        },
        "kotonoha.projectId": {
          "type": "string",
          "default": "",
          "description": "M6/M7 project UUID (KOTONOHA_PROJECT_ID for scoped export and writes)."
        }
      }
    },
    "commands": [
      {
        "command": "kotonoha.openActivity",
        "title": "Kotonoha: Show Sidebar",
        "icon": {
          "light": "media/kotonoha.svg",
          "dark": "media/kotonoha.svg"
        }
      },
      {
        "command": "kotonoha.focusContext",
        "title": "Kotonoha: Open Context Panel",
        "icon": "$(list-unordered)"
      },
      {
        "command": "kotonoha.focusMeaningDelta",
        "title": "Kotonoha: Open Meaning Delta Panel",
        "icon": "$(add)"
      },
      {
        "command": "kotonoha.focusRdeReview",
        "title": "Kotonoha: Open RDE & Review Panel",
        "icon": "$(checklist)"
      },
      {
        "command": "kotonoha.refreshContext",
        "title": "Kotonoha: Refresh Context",
        "icon": "$(refresh)"
      },
      {
        "command": "kotonoha.registerMeaningDelta",
        "title": "Kotonoha: Register Meaning Delta",
        "icon": "$(add)"
      },
      {
        "command": "kotonoha.attachRde",
        "title": "Kotonoha: Attach RDE Assessment",
        "icon": "$(json)"
      },
      {
        "command": "kotonoha.reviewApprove",
        "title": "Kotonoha: Review — Approve"
      },
      {
        "command": "kotonoha.reviewHold",
        "title": "Kotonoha: Review — Hold"
      },
      {
        "command": "kotonoha.reviewReject",
        "title": "Kotonoha: Review — Reject"
      },
      {
        "command": "kotonoha.copyExport",
        "title": "Kotonoha: Copy Export (m2) to Clipboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kotonoha",
          "title": "Kotonoha",
          "icon": "media/kotonoha.svg"
        }
      ]
    },
    "views": {
      "kotonoha": [
        {
          "type": "webview",
          "id": "kotonoha.context",
          "name": "Context"
        },
        {
          "type": "webview",
          "id": "kotonoha.meaningDelta",
          "name": "Meaning Delta"
        },
        {
          "type": "webview",
          "id": "kotonoha.rdeReview",
          "name": "RDE & Review"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kotonoha.openActivity",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "kotonoha.focusContext",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      },
      {
        "command": "kotonoha.focusMeaningDelta",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m"
      },
      {
        "command": "kotonoha.focusRdeReview",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      },
      {
        "command": "kotonoha.registerMeaningDelta",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kotonoha.openActivity",
          "when": "view == kotonoha.context || view == kotonoha.meaningDelta || view == kotonoha.rdeReview",
          "group": "navigation@0"
        },
        {
          "command": "kotonoha.refreshContext",
          "when": "view == kotonoha.context",
          "group": "navigation@1"
        },
        {
          "command": "kotonoha.focusContext",
          "when": "view == kotonoha.meaningDelta || view == kotonoha.rdeReview",
          "group": "navigation@1"
        },
        {
          "command": "kotonoha.registerMeaningDelta",
          "when": "view == kotonoha.meaningDelta",
          "group": "navigation@2"
        },
        {
          "command": "kotonoha.focusMeaningDelta",
          "when": "view == kotonoha.context || view == kotonoha.rdeReview",
          "group": "navigation@2"
        },
        {
          "command": "kotonoha.attachRde",
          "when": "view == kotonoha.rdeReview",
          "group": "navigation@2"
        },
        {
          "command": "kotonoha.focusRdeReview",
          "when": "view == kotonoha.context || view == kotonoha.meaningDelta",
          "group": "navigation@3"
        },
        {
          "command": "kotonoha.copyExport",
          "when": "view == kotonoha.rdeReview",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kotonoha.openActivity",
          "when": "true"
        },
        {
          "command": "kotonoha.focusContext",
          "when": "true"
        },
        {
          "command": "kotonoha.focusMeaningDelta",
          "when": "true"
        },
        {
          "command": "kotonoha.focusRdeReview",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && tsc -p tsconfig.test.json && node --test out-test/*.test.js",
    "test:e2e": "npm run compile && node test/e2e/run.cjs",
    "lint": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "typescript": "^5.4.0"
  }
}
